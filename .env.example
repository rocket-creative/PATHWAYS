# =============================================================================
# PATHWAYS WITHIN - ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# Email Service (Resend)
# -----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND=re_your_api_key_here
RESEND_API_KEY=re_your_api_key_here

# Resend from email (must be from a verified domain)
# For testing: onboarding@resend.dev
# For production: noreply@pathwayswithin.com (after verifying domain)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email recipients
BUSINESS_INTAKE_EMAIL=georgestoff@rocketcreative.net

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Hide the domain indicator badge (set to true before going live)
NEXT_PUBLIC_HIDE_SITE_INDICATOR=false

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - NEXT_PUBLIC_* variables are exposed to the browser
# - Other variables are server-side only
# - Copy this file to .env.local for local development
