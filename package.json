{
  "name": "pathways-within-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=@pathways/main",
    "dev:wisdom": "turbo run dev --filter=@pathways/wisdom",
    "dev:wellness": "turbo run dev --filter=@pathways/wellness",
    "dev:crm": "turbo run dev --filter=@pathways/crm",
    "build": "turbo run build",
    "build:main": "turbo run build --filter=@pathways/main",
    "build:wisdom": "turbo run build --filter=@pathways/wisdom",
    "build:wellness": "turbo run build --filter=@pathways/wellness",
    "build:crm": "turbo run build --filter=@pathways/crm",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@9.0.0"
}
